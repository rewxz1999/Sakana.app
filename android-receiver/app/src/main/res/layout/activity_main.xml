<?xml version="1.0" encoding="utf-8"?>
<!--
  主界面 = 两层，靠可见性切换（不是两个 Activity —— 换 Activity 会重建播放器、画面会断）：

  ① home_view（空闲态）：**固定状态卡 + 单个 RecyclerView + 固定底栏**
     为什么是"单个 RecyclerView"而不是"ScrollView 里套两个 RecyclerView"：
     那正是用户反馈的"收藏翻不动、看不到其它收藏"的根因 —— 嵌套在 ScrollView 里的
     RecyclerView 用 wrap_content 时，父容器只给 AT_MOST 的高度，LinearLayoutManager
     只会布局"装得下"的那些项，剩下的条目根本没被创建，于是**滚不到**；
     而内外两层都能滚又会让手势打架。改成"一个 RecyclerView 装下所有内容
     （分区标题 + 收藏网格 + 历史卡片，用 span size 区分）"后，
     只有一层滚动、条目全部参与回收，两个毛病一起消失。
     固定的状态卡与底栏留在 RecyclerView 之外，所以状态一直可见、底栏一直可点。

  ② player_layer（播放态）：播放器铺满窗口 + 官方控制栏（见 player_control_view.xml）
     + 一个透明手势层。手势层放在 PlayerView **之前**（z 序更低），
     这样控制栏上的按钮永远先拿到点击，手势只在"画面空白处"生效。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <!-- ==================== ① 首页 ==================== -->
    <LinearLayout
        android:id="@+id/home_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 状态卡：设备名 / 大字状态 / 副状态 / 本机地址（点击复制）/ 同步状态 -->
        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface_header"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/accent"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="end"
                    android:maxLines="1"
                    android:paddingStart="12dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/state_idle"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="@string/detail_waiting"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/row_addr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/addr_label"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tv_addr"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:paddingStart="8dp"
                    android:textColor="@color/accent"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_addr_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="8dp"
                    android:text="@string/addr_tap_to_copy"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_sync_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="@string/sync_status_offline"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <!--
          唯一的滚动容器：收藏网格 + 观看历史都由 HomeAdapter 用 span size 拼进来。
          clipToPadding=false + 上下留白，让最后一行卡片不会被底栏顶住、也不会被状态卡切掉。
        -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_home"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="8dp" />

        <!-- 固定底栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface_header"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp">

            <Button
                android:id="@+id/btn_sync_now"
                style="@style/AppButtonOutline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/sync_now" />

            <Button
                android:id="@+id/btn_settings_home"
                style="@style/AppButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/settings" />
        </LinearLayout>
    </LinearLayout>

    <!-- ==================== ② 播放层（全屏） ==================== -->
    <FrameLayout
        android:id="@+id/player_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:visibility="gone">

        <!--
          手势层：透明、盖住整块画面。
          它是**画面空白处**的触摸目标（控制栏上的按钮在 PlayerView 内部、z 序更高，
          所以按钮永远优先拿到点击）。双击快进、上下滑音量/亮度都在这里。
        -->
        <View
            android:id="@+id/gesture_layer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:focusable="false" />

        <!--
          Media3 官方播放器视图：画面 + 缓冲转圈 + 错误文案 + 字幕 + 官方控制栏。
          控制栏布局换成我们自己的 player_control_view.xml（白蓝配色 + 多出来的按钮），
          但拖动进度、时间、倍速、上一下一这些行为仍然是官方实现。
        -->
        <androidx.media3.ui.PlayerView
            android:id="@+id/player_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/black"
            app:controller_layout_id="@layout/player_control_view"
            app:resize_mode="fit"
            app:show_buffering="always"
            app:show_timeout="4000"
            app:surface_type="surface_view"
            app:use_controller="true" />
    </FrameLayout>
</FrameLayout>
