<?xml version="1.0" encoding="utf-8"?>
<!--
  主界面 = 两层，靠可见性切换（不是两个 Activity —— 换 Activity 会重建播放器、画面会断）：

  ① home_view（空闲态）：固定状态卡 + **顶部 Tab（收藏 / 历史）+ 两个各自独立的列表** + 固定底栏。
     收藏是一个 RecyclerView（两列网格），历史是另一个（整行卡片），同一时刻只显示一个。
     为什么是两个列表而不是"一个列表换数据源"（V1.1 改）：
       · 两个 View 各自持有 LayoutManager，**滚动位置天然独立** —— 切回来还在原来那一屏；
       · 两种界面本来就要不同的布局（网格 vs 整行），塞进一个列表得为每行算 span size。
     ⚠️ 两个列表都是 0dp + weight=1（父容器给**精确高度**，不是 AT_MOST）：
     这正是当初"收藏翻不动、看不到其它收藏"的根因 —— 用 wrap_content 时
     LinearLayoutManager 只会布局"装得下"的那些项，剩下的条目根本没被创建，于是滚不到。
     **不要再改回 wrap_content**。固定的状态卡与底栏留在列表之外，所以状态一直可见、底栏一直可点。

  ② player_layer（播放态）：播放器铺满窗口 + 官方控制栏（见 player_control_view.xml）
     + 一个透明手势层。手势层放在 PlayerView **之前**（z 序更低），
     这样控制栏上的按钮永远先拿到点击，手势只在"画面空白处"生效。

  （更完整的说明见 README §2.5b 与 §4；这份注释只讲"布局为什么长这样"。）
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <!-- ==================== ① 首页 ==================== -->
    <LinearLayout
        android:id="@+id/home_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 状态卡：设备名 / 大字状态 / 副状态 / 本机地址（点击复制）/ 同步状态 -->
        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface_header"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/accent"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="end"
                    android:maxLines="1"
                    android:paddingStart="12dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/state_idle"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="@string/detail_waiting"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/row_addr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/addr_label"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tv_addr"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:paddingStart="8dp"
                    android:textColor="@color/accent"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_addr_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="8dp"
                    android:text="@string/addr_tap_to_copy"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_sync_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="@string/sync_status_offline"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <!--
          收藏 / 历史分成两个界面（顶部 Tab 切换）。
          为什么用两个 RecyclerView 而不是一个列表换数据源：
          两个 View 各自持有自己的 LayoutManager，**滚动位置天然独立** ——
          切回来时用户还在原来那一屏，不用自己记、也不用手动 restoreState。
          高度都是 0dp + weight=1，父容器给的是**精确高度**（不是 AT_MOST），
          所以列表能滚到底（这正是当初"收藏翻不动"的根因，别再改回 wrap_content）。
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingTop="6dp"
            android:paddingEnd="10dp">

            <Button
                android:id="@+id/tab_favorites"
                style="@style/AppButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/tab_favorites" />

            <Button
                android:id="@+id/tab_history"
                style="@style/AppButtonOutline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/tab_history" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_favorites"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="8dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_history"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="8dp"
            android:visibility="gone" />

        <!-- 固定底栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface_header"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp">

            <Button
                android:id="@+id/btn_sync_now"
                style="@style/AppButtonOutline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/sync_now" />

            <Button
                android:id="@+id/btn_settings_home"
                style="@style/AppButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/settings" />
        </LinearLayout>
    </LinearLayout>

    <!-- ==================== ② 播放层（全屏） ==================== -->
    <FrameLayout
        android:id="@+id/player_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:visibility="gone">

        <!--
          手势层：透明、盖住整块画面。
          ⚠️ 它是**故意**排在播放器之前（z 序更低）的，从 v0.3.8 起就是这个顺序，不要挪到后面。
          真正会收到触摸的是播放器内部的 `surface_container`（GSY 把触摸监听挂在那里），
          手势同时挂在两处，见 PlaybackUi.bind() 的说明。

          控制栏按钮在播放器视图树里、且 z 序更高，ViewGroup 派发触摸时先给子 View，
          所以"按钮优先拿到点击、空白处才走手势"这个关系不变。
        -->
        <View
            android:id="@+id/gesture_layer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:focusable="false" />

        <!--
          GSY 的播放器视图（`SakanaGsyPlayer` 继承自 StandardGSYVideoPlayer）。
          它自己 inflate `player_gsy_view.xml` 作为画面 + 控制栏，所以这里没有任何
          app:xxx 属性 —— 上一个版本那一堆 `app:controller_layout_id` / `app:resize_mode`
          是 Media3 PlayerView 的东西，换成 GSY 之后全部由 GSYVideoOptionBuilder 设置。

          为什么还要包一层 FrameLayout：`PlaybackUi.setPlayerMode` 是按"父容器的可见性"
          来切两个形态的（首页层 / 播放层），GSY 的视图自己不负责这件事。
        -->
        <app.sakana.receiver.SakanaGsyPlayer
            android:id="@+id/player_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/black" />
    </FrameLayout>
</FrameLayout>
