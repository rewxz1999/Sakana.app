<?xml version="1.0" encoding="utf-8"?>
<!--
  自适应图标的前景层：白色的"投屏"符号（一块屏幕 + 三道扩散的弧线）。

  为什么画在 24..84 这个范围：自适应图标是 108x108，但只有中间约 **66x66** 是安全区
  —— 外面的部分会被各种形状的蒙版裁掉。屏幕矩形取 x=42..80 / y=26..50，
  弧线以 (28,80) 为圆心、半径 12/24/36，整体落在 24.5..84 × 26..83.5，
  正好待在安全区内，圆的、方的、水滴形的桌面都不会切到它。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- 屏幕：圆角矩形 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M45,26h32a3,3 0 0 1 3,3v18a3,3 0 0 1 -3,3h-32a3,3 0 0 1 -3,-3v-18a3,3 0 0 1 3,-3z" />
    <!-- 三道扩散弧：表示"投到这块屏幕上" -->
    <path
        android:fillColor="#00000000"
        android:pathData="M28,68 A12,12 0 0 1 40,80"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round"
        android:strokeWidth="6" />
    <path
        android:fillColor="#00000000"
        android:pathData="M28,56 A24,24 0 0 1 52,80"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round"
        android:strokeWidth="6" />
    <path
        android:fillColor="#00000000"
        android:pathData="M28,44 A36,36 0 0 1 64,80"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round"
        android:strokeWidth="6" />
</vector>
