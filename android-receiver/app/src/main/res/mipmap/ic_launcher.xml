<?xml version="1.0" encoding="utf-8"?>
<!--
  API 24/25 用的传统图标（自适应图标是 API 26 才有的）。
  用矢量图而不是多套 PNG：一个文件适配所有分辨率，仓库里也不用塞二进制资源。
  系统在 API 24 起原生支持VectorDrawable，启动器通过 PackageManager 取的就是普通的 Drawable，
  所以这里不会出现"某些机器上图标空白"的问题。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="48"
    android:viewportHeight="48">
    <path
        android:fillColor="#0F1B22"
        android:pathData="M0,0h48v48h-48z" />
    <path
        android:fillColor="#4DD0E1"
        android:pathData="M19,14 L19,34 L34,24 Z" />
</vector>
