# ---- 依赖与构建产物 ----
node_modules/
out/
dist/
release/
# 例外：安卓接收端的安装包要入库（v0.3.8）。
# 用户要求「移动端投屏应用也上传到 git，并且在投屏设置中增加下载的地址」——
# 电脑端「设置 → 投屏」里那条下载地址指向的就是这个 APK。
# ⚠️ 父目录必须显式重新包含：git 不会进入被忽略的目录，只写文件级的 `!` 是无效的。
!android-receiver/dist/
!android-receiver/dist/*.apk
*.tsbuildinfo
# 本地依赖缓存（含 electron 压缩包、libmpv dll 等，体积巨大且可重新下载）
.npm-cache/
.electron-cache/
.cache/

# ---- 大体积运行时不入库（用 npm run {libmpv,ffmpeg,aria2}:fetch 获取） ----
resources/libmpv/
resources/ffmpeg/
resources/aria2/*.exe
resources/aria2/*.zip
resources/ffmpeg/*.zip
resources/libmpv/*.zip
# N-API 原生插件的编译产物（源码在 native/mpv/src）
native/mpv/build/

# ---- 安全：绝不入库的凭据与本地配置 ----
# 注意：.npmrc 只含国内镜像地址（无凭据），因此**保留入库**，方便其他人直接安装依赖
.env
.env.*
*.local
*.key
*.pem
*.pfx
*.p12
secrets.json
**/credentials.json

# ---- 内部文档：按用户要求只保留在本地，不进仓库 ----
# （仓库里的 README 是缩略版；这几份是完整的项目说明、更新记录、审计报告与调研笔记）
docs/代码审计.md
docs/项目说明书.md
docs/更新记录.md
docs/备用数据源调研.md

# ---- v1.1：安卓端的验证素材与自测产物（与电脑端 .e2e/ 同理，只留本地） ----
# .verify/ 是投屏真机验证用的 8 秒 HLS 短片与本地伺服脚本，.selftest7/ 是
# V1.1 自测（55 条断言）的 java 源码与编译产物；两者都是"跑一次就丢"的东西，
# 且 .class 属于构建产物，不该进仓库。
android-receiver/.verify/
android-receiver/.selftest7/
# 同理：沙箱构建用的 gradle 缓存目录（默认 ~/.gradle 只读，本仓库指向这里）
android-receiver/.gradle-home/
# ANDROID_USER_HOME 指到仓库里（默认 ~/.android 在受限环境下写不进去），
# 但**签名密钥不入库**：dist/ 里发布的 APK 是用这把 debug.keystore 签的
# （SHA-256 cd9567a9…3a5f），谁拿到它就能签出"能覆盖安装线上包"的 APK，
# 所以这里整目录忽略，密钥只留在本机。
# 换机器/重装后想让新构建出来的包还能原地覆盖安装，就把原来那把 keystore
# 放回 android-receiver/.android-home/debug.keystore；没有它也能构建，
# 只是签名会变、用户得先卸载再装（数据会丢）。
android-receiver/.android-home/

# ---- 运行期数据、诊断输出与临时文件 ----
# v0.2.9 最后更新：数据根目录改到**安装目录**下（开发态就是仓库目录），
# 因此这几个运行期目录必须忽略，否则开发时跑一次就会把缓存/截图/下载内容带进提交。
data/
cache/
downloads/
screenshots/
galgame-screenshots/
logs/
*.log
.cap*.log
.tmp-*
# 编辑器/工具在源码目录旁边留下的临时目录（例如 .galSprite.ts.6300.<uuid>.tmpdir/）
*.tmpdir/
.testmedia/
.shots/
.tstest/
.DS_Store
Thumbs.db

# ---- v0.2.10：增量更新的自检产物 ----
# .e2e/ 是「复制一份旧安装目录 → 造出差异 → 生成补丁 → 真跑一遍覆盖」的端到端测试
# （含 900MB 的安装目录副本），.patchpeek/ 是补丁解包后用于核对哈希的临时目录。
.e2e/
.patchpeek/

# ---- v0.2.12：只留在本地的构建期信息 ----
# 用户要求「关于页显示项目作者，但作者名字不要传到 git 仓库」：
# 名字放在这个被忽略的文件里，构建时由 electron.vite.config.ts 读进 __SAKANA_AUTHOR__。
# 仓库里只有变量名、没有名字本身；删掉这个文件也能正常构建（关于页只是不显示作者）。
sakana.local.json


/logs.json
/.tmp-*/
streamBoostLog.json

# ---- 真机验证的临时产物（截图 / uiautomator dump），只留本地 ----
.verify/

